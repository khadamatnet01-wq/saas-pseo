{
  "name": "stackradar-b2b-reviews",
  "version": "2.1.0",
  "private": true,
  "description": "StackVS - 50 B2B SaaS Tools Reviews, Alternatives & Comparisons Portal",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate": "tsx scripts/validate-and-etl.ts",
    "og:generate": "tsx scripts/generate-og.ts",
    "sitemap:partition": "tsx scripts/generate-sitemaps.ts",
    "indexnow:push": "tsx scripts/indexnow-submit.ts",
    "build": "npm run validate && astro build && npm run sitemap:partition",
    "build:pseo": "npm run validate && astro build && npm run sitemap:partition && npm run indexnow:push",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^4.15.0",
    "csv-parse": "^5.5.6",
    "satori": "^0.10.14",
    "satori-html": "^0.3.2",
    "schema-dts": "^1.1.2",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "wrangler": "^4.151.2"
  }
}