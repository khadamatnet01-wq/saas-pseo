# النطاق الأساسي للموقع (يُستخدم في توليد الروابط القانونية Canonical وخرائط المواقع و IndexNow)
PUBLIC_SITE_URL="https://saascompare.example.com"
PUBLIC_SITE_NAME="B2B SaaS Radar"

# مسار ملف البيانات الافتراضي لسكريبت الـ ETL
DATA_CSV_PATH="data/tools_saas_dataset.csv"

# إعدادات مقسم خرائط المواقع (الحد المسموح بين 10000 و 45000 مسار لكل ملف)
SITEMAP_MAX_URLS_PER_FILE="25000"

# إعدادات بروتوكول الأرشفة الفورية IndexNow API
INDEXNOW_API_KEY="8f9d2a7b4c6e1f3a9d8b7c6e5f4a3b2c"
INDEXNOW_ENDPOINT="https://api.indexnow.org/indexnow"
INDEXNOW_DRY_RUN="true"

# إعدادات الحد الأدنى لجودة الصفحات (لمنع أرشفة الصفحات الضعيفة Thin Content)
MIN_FEATURES_FOR_INDEXING="5"
MIN_PROS_CONS_FOR_INDEXING="2"
