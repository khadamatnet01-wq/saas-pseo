---
import type { EnrichedSaaSTool } from '../schemas/tool.schema';
import { FEATURE_LABELS } from '../lib/content-engine';

interface Props {
  tools: EnrichedSaaSTool[];
}

const { tools } = Astro.props;
const featureKeys = Object.keys(tools[0]?.features_matrix || {});
---

<div class="card" style="overflow-x: auto;">
  <h2 style="margin-bottom: 1rem;">مصفوفة مقارنة الميزات التقنية (Features Matrix)</h2>
  <table>
    <thead>
      <tr>
        <th>المعيار / الميزة التقنية</th>
        {tools.map((t) => (
          <th>{t.tool_name}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>التصنيف (Category)</strong></td>
        {tools.map((t) => (
          <td>{t.category}</td>
        ))}
      </tr>
      <tr>
        <td><strong>نموذج التسعير</strong></td>
        {tools.map((t) => (
          <td>{t.pricing_model}</td>
        ))}
      </tr>
      <tr>
        <td><strong>السعر الابتدائي</strong></td>
        {tools.map((t) => (
          <td dir="ltr">{t.pricing_starting_at}</td>
        ))}
      </tr>
      <tr>
        <td><strong>التقييم العام</strong></td>
        {tools.map((t) => (
          <td>★ {t.rating} / 5.0</td>
        ))}
      </tr>
      {featureKeys.map((key) => (
        <tr>
          <td>{FEATURE_LABELS[key]?.ar || key}</td>
          {tools.map((t) => {
            const val = t.features_matrix[key];
            return (
              <td>
                {val === true ? '✅ مدعوم' : '❌ غير مدعوم'}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
