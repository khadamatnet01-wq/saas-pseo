---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQSection from '../../components/FAQSection.astro';
import { getAllTools, getResolvedAlternatives, getOutboundUrl } from '../../lib/data-loader';
import { generateToolFAQs } from '../../lib/content-engine';
import { generateFAQPageSchema, generateBreadcrumbSchema } from '../../lib/schema-generator';
import { buildSEOMetadata } from '../../lib/seo-engine';
import type { EnrichedSaaSTool } from '../../schemas/tool.schema';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

interface Props {
  tool: EnrichedSaaSTool;
}

const { tool } = Astro.props;
const allTools = getAllTools();
const resolvedAlts = getResolvedAlternatives(tool);
const sameCategoryRivals = allTools.filter(
  (t) => t.category === tool.category && t.slug !== tool.slug
);
const alternatives = resolvedAlts.length > 0 ? resolvedAlts : sameCategoryRivals.slice(0, 5);

const topRival1 = alternatives[0]?.tool_name.replace(/\s+(CRM|Sales Cloud|Software)$/i, '') || 'Top Rivals';
const topRival2 = alternatives[1]?.tool_name.replace(/\s+(CRM|Sales Cloud|Software)$/i, '');
const rivalPairText = topRival2 ? `${topRival1} & ${topRival2}` : topRival1;

const dynamicTitle = `Best ${tool.tool_name} Alternatives 2026: Why Teams Switch to ${rivalPairText}`;
const dynamicDescription = `Looking to replace ${tool.tool_name} (${tool.pricing_starting_at})? Compare the ${alternatives.length} best ${tool.tool_name} alternatives in 2026—including ${rivalPairText}—by price and features.`;

const faqs = generateToolFAQs(tool, alternatives);
const siteUrl = (process.env.PUBLIC_SITE_URL || 'https://stackvs.xyz').replace(/\/+$/, '');
const pageUrl = `${siteUrl}/alternatives/${tool.slug}-alternatives`;
const mentionedTools = [tool, ...alternatives];

const seo = buildSEOMetadata({
  title: dynamicTitle,
  description: dynamicDescription,
  canonicalPath: `/alternatives/${tool.slug}-alternatives`,
  ogSlug: `alt-${tool.slug}`,
  shouldIndex: tool.seo_metrics.should_index && alternatives.length > 0,
  lastModified: tool.last_updated,
  schemas: [
    generateFAQPageSchema(faqs),
    generateBreadcrumbSchema([
      { name: 'Home', url: siteUrl },
      { name: tool.tool_name, url: `${siteUrl}/tools/${tool.slug}` },
      { name: `${tool.tool_name} Alternatives`, url: pageUrl }
    ])
  ]
});
---

<BaseLayout seo={seo}>
  <div class="card" style="margin-bottom: 2rem; background: #ffffff; border: 1.5px solid #e2e8f0; padding: 2rem 1.5rem;">
    <div style="display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap;">
      <div style="width: 58px; height: 58px; border-radius: 12px; background: #f8fafc; border: 1.5px solid #e2e8f0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 6px;">
        <img
          src={tool.logo_url}
          alt={`${tool.tool_name} logo`}
          width="44"
          height="44"
          loading="eager"
          style="max-width: 100%; max-height: 100%; object-fit: contain;"
        />
      </div>
      <div style="flex: 1; min-width: 240px;">
        <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap;">
          <span class="badge badge-accent">{tool.category}</span>
          <span class="badge badge-neutral">Top {alternatives.length} Competitors</span>
        </div>
        <h1 style="font-size: clamp(1.75rem, 4vw, 2.45rem); font-weight: 800; color: #0f172a; letter-spacing: -0.025em; line-height: 1.2;">
          {dynamicTitle}
        </h1>
        <p style="font-size: 1.05rem; color: #475569; margin-top: 0.6rem; max-width: 820px; line-height: 1.65;">
          While <strong>{tool.tool_name}</strong> ({tool.pricing_starting_at}, rated ★ {tool.rating}/5) is a leading choice for {tool.category}, growing teams often evaluate alternatives for lower seat costs, specialized workflows, or deeper native automations.
        </p>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 3rem;">
    <h2 style="font-size: 1.55rem; font-weight: 800; color: #0f172a; margin-bottom: 0.4rem;">
      Side-by-Side Comparison Matrix: {tool.tool_name} vs Top Rivals
    </h2>
    <p style="color: #64748b; margin-bottom: 1.25rem; font-size: 0.95rem;">
      Compare entry pricing, user ratings, and core capabilities across {tool.tool_name} and its closest competitors.
    </p>
    <ComparisonTable tools={[tool, ...alternatives.slice(0, 3)]} />
  </div>

  <div style="margin-bottom: 3rem;">
    <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin-bottom: 1.25rem;">
      Detailed Breakdown of the Top {alternatives.length} {tool.tool_name} Competitors
    </h2>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      {alternatives.map((alt, index) => {
        const [first, second] = [tool.slug, alt.slug].sort((a, b) => a.localeCompare(b));
        return (
          <div class="card" style="border: 1.5px solid #e2e8f0; background: #ffffff; padding: 1.75rem 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
              <div style="display: flex; align-items: center; gap: 0.9rem;">
                <div style="width: 52px; height: 52px; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; padding: 6px; flex-shrink: 0;">
                  <img src={alt.logo_url} alt={`${alt.tool_name} logo`} width="38" height="38" loading="lazy" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                </div>
                <div>
                  <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                    <span class="badge badge-accent">#{index + 1} Alternative</span>
                    <span class="badge badge-warning">★ {alt.rating} / 5.0</span>
                    <span class="badge badge-neutral">Starts at {alt.pricing_starting_at}</span>
                  </div>
                  <h3 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-top: 0.3rem;">
                    {alt.tool_name}
                  </h3>
                </div>
              </div>
              <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
                <a href={`/compare/${first}-vs-${second}`} class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.55rem 0.95rem;">
                  {tool.tool_name} vs {alt.tool_name}
                </a>
                <a href={getOutboundUrl(alt)} target="_blank" rel="sponsored nofollow noopener noreferrer" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.55rem 1.1rem;">
                  Try {alt.tool_name} &rarr;
                </a>
              </div>
            </div>
            <p style="color: #475569; font-size: 0.98rem; line-height: 1.6; margin-bottom: 1rem;">
              {alt.summary}
            </p>
            <div style="background: #f8fafc; border-radius: 10px; padding: 0.9rem 1.1rem; border: 1px solid #e2e8f0;">
              <div style="font-size: 0.82rem; font-weight: 700; color: #0f172a; text-transform: uppercase; margin-bottom: 0.4rem;">
                Why teams choose {alt.tool_name} over {tool.tool_name}:
              </div>
              <ul style="margin: 0; padding-left: 1.2rem; color: #334155; font-size: 0.92rem; line-height: 1.6;">
                {alt.pros.slice(0, 3).map((pro) => (
                  <li>{pro}</li>
                ))}
              </ul>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <FAQSection faqs={faqs} heading={`${tool.tool_name} Alternatives FAQ`} />

  <section style="margin: 3.5rem 0 2rem;">
    <div class="card" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 2rem 1.5rem;">
      <h2 style="font-size: 1.45rem; font-weight: 800; color: #0f172a; margin-bottom: 0.35rem;">
        Official Website Links for All {mentionedTools.length} Mentioned Platforms
      </h2>
      <p style="font-size: 0.92rem; color: #475569; margin-bottom: 1.25rem;">
        Direct access to official pricing pages and free trials:
      </p>
      <div style="display: flex; flex-direction: column; gap: 0.85rem;">
        {mentionedTools.map((t) => (
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.2rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
              <img src={t.logo_url} alt={t.tool_name} width="32" height="32" loading="lazy" style="object-fit: contain; border-radius: 6px;" />
              <div>
                <a href={`/tools/${t.slug}`} style="font-weight: 800; color: #0f172a; font-size: 1rem;">{t.tool_name}</a>
                <div style="font-size: 0.8rem; color: #64748b;">Starts at {t.pricing_starting_at} • ★ {t.rating}/5.0</div>
              </div>
            </div>
            <div style="display: flex; gap: 0.6rem;">
              <a href={`/tools/${t.slug}`} class="btn btn-secondary" style="padding: 0.5rem 0.85rem; font-size: 0.82rem;">Review</a>
              <a href={getOutboundUrl(t)} target="_blank" rel="sponsored nofollow noopener noreferrer" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.82rem;">Official Site &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
