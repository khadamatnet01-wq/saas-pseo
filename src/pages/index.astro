---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllTools, getAllComparisonPairs, getOutboundUrl } from '../lib/data-loader';
import { buildSEOMetadata } from '../lib/seo-engine';

const tools = getAllTools();
const pairs = getAllComparisonPairs();

const categories = Array.from(new Set(tools.map((t) => t.category)));

const seo = buildSEOMetadata({
  title: `StackVS — Compare ${tools.length} B2B Software Tools & ${pairs.length} Head-to-Head Reviews (2026)`,
  description: `Independent buyer's guide evaluating ${tools.length} enterprise SaaS platforms across Project Management, CRM, Knowledge Bases, Customer Support, and Workflow Automation.`,
  canonicalPath: '/',
  ogSlug: 'home',
  shouldIndex: true
});
---

<BaseLayout seo={seo}>
  <!-- Hero Section -->
  <section style="text-align: center; padding: 2rem 0 3rem; max-width: 860px; margin: 0 auto;">
    <div class="badge badge-accent" style="margin-bottom: 1rem; font-size: 0.85rem;">
      2026 Enterprise Software Index • {tools.length} Verified Platforms • {pairs.length} Direct Comparisons
    </div>
    <h1 style="font-size: 2.75rem; font-weight: 800; letter-spacing: -0.03em; color: var(--primary); line-height: 1.15; margin-bottom: 1rem;">
      Find & Compare the Best B2B Software for Your Stack
    </h1>
    <p style="font-size: 1.12rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 2rem;">
      Side-by-side technical benchmarks, verified pricing models, and unbiased feature matrices across 5 core enterprise software categories.
    </p>
    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="#software" class="btn btn-primary">Explore {tools.length} Software Reviews</a>
      <a href="#comparisons" class="btn btn-secondary">Browse {pairs.length} Comparisons</a>
    </div>
  </section>

  <!-- Category Quick Jump Pills -->
  <section style="margin-bottom: 3rem; display: flex; gap: 0.65rem; flex-wrap: wrap; justify-content: center;">
    {categories.map((cat) => {
      const count = tools.filter((t) => t.category === cat).length;
      return (
        <a href={`#cat-${cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="badge badge-neutral" style="padding: 0.5rem 1rem; font-size: 0.88rem; border: 1px solid var(--border); background: #fff;">
          {cat} ({count})
        </a>
      );
    })}
  </section>

  <!-- Software Directory Grouped by Category -->
  <div id="software">
    {categories.map((cat) => {
      const catTools = tools.filter((t) => t.category === cat);
      const catId = `cat-${cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
      return (
        <section id={catId} style="margin-bottom: 4rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--border);">
            <div>
              <span class="badge badge-accent" style="margin-bottom: 0.4rem;">Category Cluster</span>
              <h2 style="font-size: 1.65rem; font-weight: 800; color: var(--primary);">{cat}</h2>
            </div>
            <span style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted);">{catTools.length} Platforms Evaluated</span>
          </div>

          <div class="grid-3">
            {catTools.map((tool) => (
              <article class="card card-hover" style="display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                    <span class="badge badge-neutral">{tool.pricing_model}</span>
                    <span class="badge badge-warning">★ {tool.rating}</span>
                  </div>
                  <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.4rem;">
                    <a href={`/tools/${tool.slug}`} style="color: var(--primary);">{tool.tool_name}</a>
                  </h3>
                  <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.55; margin-bottom: 1rem;">
                    {tool.summary}
                  </p>
                </div>

                <div>
                  <div style="padding-top: 0.85rem; border-top: 1px solid var(--border); margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
                    <span style="font-weight: 700; color: var(--text);">{tool.pricing_starting_at}</span>
                    <a href={`/alternatives/${tool.slug}-alternatives`} style="font-weight: 600;">
                      {tool.alternatives_ids.length} Alternatives &rarr;
                    </a>
                  </div>
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem;">
                    <a href={`/tools/${tool.slug}`} class="btn btn-secondary" style="padding: 0.55rem 0.75rem; font-size: 0.85rem;">
                      Full Review
                    </a>
                    <a
                      href={getOutboundUrl(tool)}
                      target="_blank"
                      rel="sponsored nofollow noopener noreferrer"
                      class="btn btn-primary"
                      style="padding: 0.55rem 0.75rem; font-size: 0.85rem;"
                    >
                      Visit Site &rarr;
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <!-- Head-to-Head Comparisons Matrix -->
  <section id="comparisons" style="margin-top: 2rem;">
    <div style="margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--border);">
      <span class="badge badge-accent" style="margin-bottom: 0.4rem;">Direct Benchmarks</span>
      <h2 style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">All Head-to-Head Comparisons ({pairs.length})</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Side-by-side pricing, pros, cons, and 7-point feature evaluations.</p>
    </div>

    <div class="grid-3">
      {pairs.map((pair) => (
        <a href={`/compare/${pair.slug}`} class="card card-hover" style="display: block; color: inherit; padding: 1.25rem 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="badge badge-accent" style="font-size: 0.72rem;">VS Matchup</span>
            <span style="font-size: 0.8rem; color: var(--text-muted);">{pair.sharedFeaturesCount}/7 Shared Specs</span>
          </div>
          <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--primary); margin-bottom: 0.35rem;">
            {pair.toolA.tool_name} vs {pair.toolB.tool_name}
          </h3>
          <p style="color: var(--text-muted); font-size: 0.85rem;">
            {pair.toolA.pricing_starting_at} vs {pair.toolB.pricing_starting_at}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
