---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ProsConsCard from '../../components/ProsConsCard.astro';
import FAQSection from '../../components/FAQSection.astro';
import { getAllComparisonPairs, getOutboundUrl } from '../../lib/data-loader';
import { buildSEOMetadata } from '../../lib/seo-engine';
import { generateComparisonFAQs, generateComparisonVerdict } from '../../lib/content-engine';
import { generateSoftwareSchema, generateFAQSchema, generateBreadcrumbSchema } from '../../lib/schema-generator';
import type { EnrichedSaaSTool } from '../../schemas/tool.schema';

export async function getStaticPaths() {
  const pairs = getAllComparisonPairs();
  return pairs.map((pair) => {
    const [slugA, slugB] = pair.slug.split('-vs-');
    return {
      params: { slugA, slugB },
      props: {
        pairSlug: pair.slug,
        toolA: pair.toolA,
        toolB: pair.toolB,
        sharedFeaturesCount: pair.sharedFeaturesCount,
        shouldIndex: pair.shouldIndex
      }
    };
  });
}

interface Props {
  pairSlug: string;
  toolA: EnrichedSaaSTool;
  toolB: EnrichedSaaSTool;
  sharedFeaturesCount: number;
  shouldIndex: boolean;
}

const { pairSlug, toolA, toolB, sharedFeaturesCount, shouldIndex } = Astro.props;
const CURRENT_YEAR = 2026;

function extractShortHook(rawPro?: string, fallback?: string): string {
  const source = rawPro && rawPro.trim().length > 0 ? rawPro : fallback || 'Enterprise Power';
  const cleaned = source
    .replace(/^(Best-in-class|Industry-leading|Unmatched|Unrivaled|Native|Built-in|Generous|Powerful|Ultra-fast|Sub-\d+ms|Extremely|Deep|Full-stack)\s+/i, '')
    .replace(/\([^)]*\)/g, '')
    .trim();
  const words = cleaned.split(/\s+/).slice(0, 3).join(' ');
  return words.charAt(0).toUpperCase() + words.slice(1);
}

const proA = toolA.pros?.[0] || `${toolA.pricing_starting_at} Value`;
const proB = toolB.pros?.[0] || `${toolB.pricing_starting_at} Workflows`;

const hookA = extractShortHook(proA, toolA.category);
const hookB = extractShortHook(proB, toolB.category);

const dynamicTitle = `${toolA.tool_name} vs ${toolB.tool_name} ${CURRENT_YEAR}: ${hookA} or ${hookB}?`;

const rawDesc = `Stuck between ${toolA.tool_name} and ${toolB.tool_name}? Compare ${toolA.tool_name}'s ${proA.toLowerCase()} against ${toolB.tool_name}'s ${proB.toLowerCase()}. See ${CURRENT_YEAR} pricing and feature matrices.`;
const dynamicDescription =
  rawDesc.length <= 155
    ? rawDesc
    : rawDesc.slice(0, 152).replace(/\s+\S*$/, '') + '...';

const seo = buildSEOMetadata({
  title: dynamicTitle,
  description: dynamicDescription,
  canonicalPath: `/compare/${pairSlug}`,
  ogSlug: `compare-${pairSlug}`,
  shouldIndex
});

const verdict = generateComparisonVerdict(toolA, toolB);
const faqs = generateComparisonFAQs(toolA, toolB);
const outboundA = getOutboundUrl(toolA);
const outboundB = getOutboundUrl(toolB);

const siteUrl = (import.meta.env?.PUBLIC_SITE_URL || 'https://stackvs.xyz').replace(/\/$/, '');
const schemas = [
  generateSoftwareSchema(toolA, `${siteUrl}/compare/${pairSlug}`),
  generateSoftwareSchema(toolB, `${siteUrl}/compare/${pairSlug}`),
  generateFAQSchema(faqs),
  generateBreadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: 'Comparisons', url: `${siteUrl}/#comparisons` },
    { name: `${toolA.tool_name} vs ${toolB.tool_name}`, url: `${siteUrl}/compare/${pairSlug}` }
  ])
];
---

<BaseLayout seo={seo}>
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem; font-size: 0.88rem; color: #64748b; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/" style="color: #2563eb; font-weight: 600;">Home</a>
    <span>/</span>
    <a href="/#comparisons" style="color: #2563eb; font-weight: 600;">Comparisons</a>
    <span>/</span>
    <span style="color: #0f172a; font-weight: 700;">{toolA.tool_name} vs {toolB.tool_name}</span>
  </nav>

  <section class="card" style="margin-bottom: 2.5rem; background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); border: 1.5px solid #e2e8f0;">
    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem;">
      <span class="badge badge-accent">2026 Head-to-Head Benchmark</span>
      <span class="badge badge-neutral">{toolA.category}</span>
      <span class="badge badge-success">{sharedFeaturesCount}/7 Shared Core Capabilities</span>
    </div>

    <div style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; background: #ffffff; padding: 0.65rem 1rem; border-radius: 12px; border: 1.5px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
        <img src={toolA.logo_url} alt={`${toolA.tool_name} logo`} width="40" height="40" loading="eager" style="object-fit: contain; border-radius: 6px;" />
        <div>
          <div style="font-weight: 800; font-size: 1.1rem; color: #0f172a;">{toolA.tool_name}</div>
          <div style="font-size: 0.78rem; color: #64748b; font-weight: 600;">★ {toolA.rating}/5.0 • {toolA.pricing_starting_at}</div>
        </div>
      </div>

      <span style="font-weight: 800; font-size: 1.1rem; color: #2563eb; background: #eff6ff; border: 1px solid #bfdbfe; padding: 0.4rem 0.85rem; border-radius: 999px;">
        VS
      </span>

      <div style="display: flex; align-items: center; gap: 0.75rem; background: #ffffff; padding: 0.65rem 1rem; border-radius: 12px; border: 1.5px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
        <img src={toolB.logo_url} alt={`${toolB.tool_name} logo`} width="40" height="40" loading="eager" style="object-fit: contain; border-radius: 6px;" />
        <div>
          <div style="font-weight: 800; font-size: 1.1rem; color: #0f172a;">{toolB.tool_name}</div>
          <div style="font-size: 0.78rem; color: #64748b; font-weight: 600;">★ {toolB.rating}/5.0 • {toolB.pricing_starting_at}</div>
        </div>
      </div>
    </div>

    <h1 style="font-size: clamp(1.65rem, 3.8vw, 2.35rem); font-weight: 800; color: #0f172a; line-height: 1.2; margin-bottom: 1rem;">
      {dynamicTitle}
    </h1>

    <p style="font-size: 1.05rem; color: #334155; line-height: 1.7; max-width: 900px; margin-bottom: 1.5rem;">
      {verdict}
    </p>

    <div style="display: flex; gap: 0.85rem; flex-wrap: wrap;">
      <a
        href={outboundA}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="btn btn-primary"
      >
        Visit {toolA.tool_name} ({toolA.pricing_starting_at}) &rarr;
      </a>
      <a
        href={outboundB}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="btn btn-secondary"
      >
        Visit {toolB.tool_name} ({toolB.pricing_starting_at}) &rarr;
      </a>
    </div>
  </section>

  <section style="margin-bottom: 3rem;">
    <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">
      Side-by-Side Feature & Pricing Matrix
    </h2>
    <p style="font-size: 0.92rem; color: #64748b; margin-bottom: 1.25rem;">
      Direct comparison of verified entry pricing, free tiers, and core enterprise capabilities between {toolA.tool_name} and {toolB.tool_name}.
    </p>
    <ComparisonTable tools={[toolA, toolB]} />
  </section>

  <section style="margin-bottom: 3rem;">
    <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin-bottom: 1.25rem;">
      Strengths & Limitations Breakdown
    </h2>
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
          <h3 style="font-size: 1.25rem; font-weight: 800; color: #0f172a;">
            1. {toolA.tool_name} Assessment
          </h3>
          <a href={`/tools/${toolA.slug}`} style="font-size: 0.88rem; font-weight: 700; color: #2563eb;">
            Read Full {toolA.tool_name} Review &rarr;
          </a>
        </div>
        <ProsConsCard toolName={toolA.tool_name} pros={toolA.pros} cons={toolA.cons} />
      </div>

      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
          <h3 style="font-size: 1.25rem; font-weight: 800; color: #0f172a;">
            2. {toolB.tool_name} Assessment
          </h3>
          <a href={`/tools/${toolB.slug}`} style="font-size: 0.88rem; font-weight: 700; color: #2563eb;">
            Read Full {toolB.tool_name} Review &rarr;
          </a>
        </div>
        <ProsConsCard toolName={toolB.tool_name} pros={toolB.pros} cons={toolB.cons} />
      </div>
    </div>
  </section>

  <FAQSection
    title={`Frequently Asked Questions: ${toolA.tool_name} vs ${toolB.tool_name}`}
    faqs={faqs}
  />

  <section class="card" style="margin-top: 3rem; background: #f8fafc; border: 1.5px solid #e2e8f0;">
    <h2 style="font-size: 1.35rem; font-weight: 800; color: #0f172a; margin-bottom: 0.4rem;">
      Official Links & Resources for Mentioned Tools
    </h2>
    <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 1.25rem;">
      Explore official websites, live pricing calculators, and full alternative directories for the platforms compared on this page:
    </p>
    <div class="grid-2">
      {[toolA, toolB].map((item) => (
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.15rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <img src={item.logo_url} alt={`${item.tool_name} icon`} width="36" height="36" loading="lazy" style="object-fit: contain; border-radius: 6px;" />
            <div>
              <div style="font-weight: 800; color: #0f172a; font-size: 1.05rem;">{item.tool_name}</div>
              <div style="font-size: 0.8rem; color: #64748b;">Starts at {item.pricing_starting_at} ({item.pricing_model})</div>
            </div>
          </div>
          <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a
              href={getOutboundUrl(item)}
              target="_blank"
              rel="sponsored nofollow noopener noreferrer"
              class="btn btn-primary"
              style="padding: 0.5rem 0.9rem; font-size: 0.82rem; flex: 1;"
            >
              Official Website &rarr;
            </a>
            <a
              href={`/tools/${item.slug}`}
              class="btn btn-secondary"
              style="padding: 0.5rem 0.9rem; font-size: 0.82rem;"
            >
              Review
            </a>
            <a
              href={`/alternatives/${item.slug}-alternatives`}
              class="btn btn-secondary"
              style="padding: 0.5rem 0.9rem; font-size: 0.82rem;"
            >
              Alternatives
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
