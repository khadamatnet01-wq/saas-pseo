---
import type { FAQItem } from '../lib/content-engine';

interface Props {
  faqs: FAQItem[];
  heading?: string;
}

const { faqs, heading = 'الأسئلة الشائعة (FAQs)' } = Astro.props;
---

<section class="card">
  <h2 style="margin-bottom: 1rem;">{heading}</h2>
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    {faqs.map((faq) => (
      <details style="border: 1px solid var(--border); border-radius: 8px; padding: 1rem; background: #fcfcfd;" open>
        <summary style="font-weight: 700; cursor: pointer;">{faq.question}</summary>
        <p style="margin-top: 0.65rem; color: var(--muted);">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>
