---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ProsConsCard from '../../components/ProsConsCard.astro';
import FAQSection from '../../components/FAQSection.astro';
import { getAllComparisonPairs, type ComparisonPair, getOutboundUrl } from '../../lib/data-loader';
import { generateComparisonFAQs, generateComparisonVerdict } from '../../lib/content-engine';
import {
  generateComparisonSchema,
  generateFAQPageSchema,
  generateBreadcrumbSchema
} from '../../lib/schema-generator';
import { buildSEOMetadata } from '../../lib/seo-engine';

export async function getStaticPaths() {
  const pairs = getAllComparisonPairs();
  return pairs.map((pair) => ({
    params: {
      slugA: pair.toolA.slug,
      slugB: pair.toolB.slug
    },
    props: { pair }
  }));
}

interface Props {
  pair: ComparisonPair;
}

const { pair } = Astro.props;
const { toolA, toolB } = pair;
const verdict = generateComparisonVerdict(toolA, toolB);
const faqs = generateComparisonFAQs(toolA, toolB);
const siteUrl = (process.env.PUBLIC_SITE_URL || 'https://stackvs.xyz').replace(/\/+$/, '');
const pageUrl = `${siteUrl}/compare/${pair.slug}`;
const mentionedTools = [toolA, toolB];

function extractShortHook(rawPro?: string, fallback?: string): string {
  const source = rawPro && rawPro.trim().length > 0 ? rawPro : fallback || 'Enterprise Power';
  const cleaned = source
    .replace(/^(Best-in-class|Industry-leading|Unmatched|Unrivaled|Native|Built-in|Generous|Powerful|Ultra-fast|Sub-\d+ms|Extremely|Deep|Full-stack)\s+/i, '')
    .replace(/\([^)]*\)/g, '')
    .trim();
  const words = cleaned.split(/\s+/).slice(0, 3).join(' ');
  return words.charAt(0).toUpperCase() + words.slice(1);
}

const proA = toolA.pros?.[0] || `${toolA.pricing_starting_at} Value`;
const proB = toolB.pros?.[0] || `${toolB.pricing_starting_at} Workflows`;
const hookA = extractShortHook(proA, toolA.category);
const hookB = extractShortHook(proB, toolB.category);

const dynamicTitle = `${toolA.tool_name} vs ${toolB.tool_name} 2026: ${hookA} or ${hookB}?`;
const dynamicDescription = `Stuck between ${toolA.tool_name} and ${toolB.tool_name}? Compare ${toolA.tool_name}'s ${proA.toLowerCase()} against ${toolB.tool_name}'s ${proB.toLowerCase()}. See 2026 pricing and feature matrices.`;

const seo = buildSEOMetadata({
  title: dynamicTitle,
  description: dynamicDescription,
  canonicalPath: `/compare/${pair.slug}`,
  ogSlug: `cmp-${pair.slug}`,
  shouldIndex: pair.shouldIndex,
  lastModified: toolA.last_updated,
  schemas: [
    generateComparisonSchema(toolA, toolB, pageUrl),
    generateFAQPageSchema(faqs),
    generateBreadcrumbSchema([
      { name: 'Home', url: siteUrl },
      { name: 'Comparisons', url: `${siteUrl}/#comparisons` },
      { name: `${toolA.tool_name} vs ${toolB.tool_name}`, url: pageUrl }
    ])
  ]
});
---

<BaseLayout seo={seo}>
  <div class="card" style="margin-bottom: 2rem; background: #ffffff; border: 1.5px solid #e2e8f0; padding: 2rem 1.5rem;">
    <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap;">
      <span class="badge badge-accent" style="font-weight: 700;">Head-to-Head Comparison</span>
      <span class="badge badge-neutral">{pair.sharedFeaturesCount}/7 Shared Core Features</span>
      <span class="badge badge-neutral">{toolA.category}</span>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem; margin: 0.75rem 0 1rem; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 0.65rem;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: #f8fafc; border: 1.5px solid #e2e8f0; display: flex; align-items: center; justify-content: center; padding: 6px;">
          <img
            src={toolA.logo_url}
            alt={`${toolA.tool_name} logo`}
            width="34"
            height="34"
            loading="eager"
            style="max-width: 100%; max-height: 100%; object-fit: contain;"
          />
        </div>
        <span style="font-size: 1.6rem; font-weight: 800; color: #0f172a;">{toolA.tool_name}</span>
      </div>

      <span style="font-size: 1.25rem; font-weight: 800; color: #94a3b8; padding: 0 0.25rem;">VS</span>

      <div style="display: flex; align-items: center; gap: 0.65rem;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: #f8fafc; border: 1.5px solid #e2e8f0; display: flex; align-items: center; justify-content: center; padding: 6px;">
          <img
            src={toolB.logo_url}
            alt={`${toolB.tool_name} logo`}
            width="34"
            height="34"
            loading="eager"
            style="max-width: 100%; max-height: 100%; object-fit: contain;"
          />
        </div>
        <span style="font-size: 1.6rem; font-weight: 800; color: #0f172a;">{toolB.tool_name}</span>
      </div>
    </div>

    <h1 style="font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; color: #0f172a; margin: 0.25rem 0 0.85rem; letter-spacing: -0.025em; line-height: 1.2;">
      {dynamicTitle}
    </h1>
    <p style="font-size: 1.05rem; color: #475569; line-height: 1.65; max-width: 860px;">
      {verdict}
    </p>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
      <a
        href={getOutboundUrl(toolA)}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="btn btn-primary"
      >
        Try {toolA.tool_name} Official &rarr;
      </a>
      <a
        href={getOutboundUrl(toolB)}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="btn btn-secondary"
      >
        Try {toolB.tool_name} Official &rarr;
      </a>
    </div>
  </div>

  <ComparisonTable tools={[toolA, toolB]} />

  <div style="margin: 3rem 0 1.5rem;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">
      {toolA.tool_name} Detailed Assessment
    </h2>
    <ProsConsCard toolName={toolA.tool_name} pros={toolA.pros} cons={toolA.cons} />
  </div>

  <div style="margin: 2.5rem 0 1.5rem;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">
      {toolB.tool_name} Detailed Assessment
    </h2>
    <ProsConsCard toolName={toolB.tool_name} pros={toolB.pros} cons={toolB.cons} />
  </div>

  <FAQSection faqs={faqs} heading={`Choosing Between ${toolA.tool_name} and ${toolB.tool_name}`} />

  <section style="margin: 3.5rem 0 2rem;">
    <div class="card" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 2rem 1.5rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem;">
        <span class="badge badge-accent" style="font-weight: 700;">Direct Directory</span>
        <span class="badge badge-neutral" style="font-weight: 600;">{mentionedTools.length} Featured Platforms</span>
      </div>
      <h2 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 0.35rem;">
        Official Links for {toolA.tool_name} & {toolB.tool_name}
      </h2>
      <p style="font-size: 0.95rem; color: #475569; margin-bottom: 1.5rem;">
        Direct official links and registration access for the software platforms evaluated in this comparison:
      </p>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        {mentionedTools.map((t) => (
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.15rem 1.25rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <div style="width: 48px; height: 48px; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 6px;">
                <img src={t.logo_url} alt={`${t.tool_name} logo`} width="36" height="36" loading="lazy" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
              </div>
              <div>
                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                  <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0;">
                    <a href={`/tools/${t.slug}`} style="color: #0f172a;">{t.tool_name}</a>
                  </h3>
                  <span class="badge badge-neutral" style="font-size: 0.75rem;">{t.category}</span>
                  <span style="font-size: 0.82rem; font-weight: 700; color: #b45309;">★ {t.rating}</span>
                </div>
                <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.2rem;">
                  Starting at <strong style="color: #0f172a;">{t.pricing_starting_at}</strong> • {t.pricing_model}
                </div>
              </div>
            </div>
            <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap;">
              <a href={`/tools/${t.slug}`} class="btn btn-secondary" style="padding: 0.6rem 0.9rem; font-size: 0.85rem;">Full Review</a>
              <a href={getOutboundUrl(t)} target="_blank" rel="sponsored nofollow noopener noreferrer" class="btn btn-primary" style="padding: 0.6rem 1.1rem; font-size: 0.85rem;">Visit Official Site &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
