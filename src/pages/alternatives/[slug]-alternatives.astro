---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQSection from '../../components/FAQSection.astro';
import { getAllTools, getResolvedAlternatives, getOutboundUrl } from '../../lib/data-loader';
import { generateToolFAQs } from '../../lib/content-engine';
import { generateFAQPageSchema, generateBreadcrumbSchema } from '../../lib/schema-generator';
import { buildSEOMetadata } from '../../lib/seo-engine';
import type { EnrichedSaaSTool } from '../../schemas/tool.schema';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

interface Props {
  tool: EnrichedSaaSTool;
}

const { tool } = Astro.props;
const alternatives = getResolvedAlternatives(tool);
const faqs = generateToolFAQs(tool, alternatives);
const siteUrl = (process.env.PUBLIC_SITE_URL || 'https://stackvs.xyz').replace(/\/+$/, '');
const pageUrl = `${siteUrl}/alternatives/${tool.slug}-alternatives`;

const seo = buildSEOMetadata({
  title: `Top ${alternatives.length} ${tool.tool_name} Alternatives & Competitors (2026)`,
  description: `Looking for an alternative to ${tool.tool_name}? Compare the top ${alternatives.length} competitors in ${tool.category} based on pricing, features, and ratings.`,
  canonicalPath: `/alternatives/${tool.slug}-alternatives`,
  ogSlug: `alt-${tool.slug}`,
  shouldIndex: tool.seo_metrics.should_index && alternatives.length > 0,
  lastModified: tool.last_updated,
  schemas: [
    generateFAQPageSchema(faqs),
    generateBreadcrumbSchema([
      { name: 'Home', url: siteUrl },
      { name: tool.tool_name, url: `${siteUrl}/tools/${tool.slug}` },
      { name: `${tool.tool_name} Alternatives`, url: pageUrl }
    ])
  ]
});
---

<BaseLayout seo={seo}>
  <div class="card" style="margin-bottom: 2rem;">
    <span class="badge badge-accent">Alternative Guide</span>
    <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--primary); margin: 0.5rem 0;">
      Best {tool.tool_name} Alternatives in 2026
    </h1>
    <p style="font-size: 1.05rem; color: var(--text-muted); max-width: 800px;">
      While {tool.tool_name} excels in {tool.pros[0]}, limitations like {tool.cons[0]} lead many teams to seek alternative options. Below is our side-by-side comparison of the top {alternatives.length} competitors.
    </p>
  </div>

  <!-- Comparison Table -->
  <ComparisonTable tools={[tool, ...alternatives]} />

  <!-- Detailed Alternative Cards -->
  <div style="margin: 3rem 0 2rem;">
    <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--primary); margin-bottom: 1.25rem;">
      Individual Competitor Breakdowns
    </h2>
    <div class="grid-2">
      {alternatives.map((alt, idx) => {
        const [first, second] = [tool.slug, alt.slug].sort((a, b) => a.localeCompare(b));
        return (
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <span class="badge badge-neutral">Alternative #{idx + 1}</span>
                <span class="badge badge-warning">★ {alt.rating}</span>
              </div>
              <h3 style="font-size: 1.35rem; font-weight: 700; color: var(--primary); margin-bottom: 0.4rem;">
                {alt.tool_name}
              </h3>
              <p style="font-size: 0.93rem; color: var(--text-muted); margin-bottom: 0.85rem;">
                {alt.summary}
              </p>
              <p style="font-size: 0.9rem; margin-bottom: 0.4rem;">
                <strong>Starting Price:</strong> {alt.pricing_starting_at} ({alt.pricing_model})
              </p>
              <p style="font-size: 0.9rem; color: #047857; margin-bottom: 1rem;">
                <strong>Top Strength:</strong> {alt.pros[0]}
              </p>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--border);">
              <a href={`/compare/${first}-vs-${second}`} class="btn btn-secondary" style="font-size: 0.85rem;">
                Compare vs {tool.tool_name}
              </a>
              <a
                href={getOutboundUrl(alt)}
                target="_blank"
                rel="sponsored nofollow noopener noreferrer"
                class="btn btn-primary"
                style="font-size: 0.85rem;"
              >
                Visit Site &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <FAQSection faqs={faqs} heading={`Switching from ${tool.tool_name} FAQ`} />
</BaseLayout>
