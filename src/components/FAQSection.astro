---
import type { FAQItem } from '../lib/content-engine';

interface Props {
  faqs: FAQItem[];
  heading?: string;
}

const { faqs, heading = 'Frequently Asked Questions' } = Astro.props;
---

<section style="margin: 2.5rem 0 1.5rem;">
  <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--primary); margin-bottom: 1.25rem;">
    {heading}
  </h2>
  <div style="display: flex; flex-direction: column; gap: 0.85rem;">
    {faqs.map((faq) => (
      <details style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.15rem 1.35rem; background: #ffffff;" open>
        <summary style="font-weight: 700; cursor: pointer; color: var(--primary); font-size: 1rem;">
          {faq.question}
        </summary>
        <p style="margin-top: 0.75rem; color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
          {faq.answer}
        </p>
      </details>
    ))}
  </div>
</section>
