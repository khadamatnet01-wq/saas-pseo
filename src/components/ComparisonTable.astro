---
import type { EnrichedSaaSTool } from '../schemas/tool.schema';
import { FEATURE_METADATA } from '../lib/content-engine';
import { getOutboundUrl } from '../lib/data-loader';

interface Props {
  tools: EnrichedSaaSTool[];
}

const { tools } = Astro.props;
const featureKeys = Object.keys(tools[0]?.features_matrix || {});
---

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th style="width: 28%;">Feature / Benchmark</th>
        {tools.map((t) => (
          <th style="width: calc(72% / tools.length);">
            <div style="font-size: 1.05rem; font-weight: 800; color: var(--primary);">{t.tool_name}</div>
            <div style="font-size: 0.8rem; font-weight: 500; text-transform: none; color: var(--text-muted); margin-top: 0.2rem;">
              {t.pricing_model}
            </div>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Starting Price</strong></td>
        {tools.map((t) => (
          <td>
            <span style="font-weight: 700; color: var(--accent);">{t.pricing_starting_at}</span>
          </td>
        ))}
      </tr>
      <tr>
        <td><strong>User Rating</strong></td>
        {tools.map((t) => (
          <td>
            <span style="color: #b45309; font-weight: 700;">★ {t.rating}</span> / 5.0
          </td>
        ))}
      </tr>
      {featureKeys.map((key) => (
        <tr>
          <td>
            <div style="font-weight: 600;">{FEATURE_METADATA[key]?.label || key}</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">{FEATURE_METADATA[key]?.description || ''}</div>
          </td>
          {tools.map((t) => {
            const hasFeature = t.features_matrix[key];
            return (
              <td>
                {hasFeature ? (
                  <span class="badge badge-success">✓ Supported</span>
                ) : (
                  <span class="badge badge-neutral" style="color: #94a3b8;">✕ Not Native</span>
                )}
              </td>
            );
          })}
        </tr>
      ))}
      <tr>
        <td><strong>Official Access</strong></td>
        {tools.map((t) => (
          <td>
            <a
              href={getOutboundUrl(t)}
              target="_blank"
              rel="sponsored nofollow noopener noreferrer"
              class="btn btn-primary"
              style="padding: 0.5rem 1rem; font-size: 0.85rem;"
            >
              Visit {t.tool_name} &rarr;
            </a>
          </td>
        ))}
      </tr>
    </tbody>
  </table>
</div>
