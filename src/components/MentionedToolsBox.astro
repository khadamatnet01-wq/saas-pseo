---
import type { EnrichedSaaSTool } from '../schemas/tool.schema';
import { getOutboundUrl } from '../lib/data-loader';

interface Props {
  tools: EnrichedSaaSTool[];
  title?: string;
  subtitle?: string;
}

const {
  tools = [],
  title = "Official Access & Mentioned Software Links",
  subtitle = "Direct verified links to official websites, free trials, and tier pricing for all platforms evaluated on this page."
} = Astro.props;

// Deduplicate tools by slug
const uniqueTools = Array.from(new Map(tools.map((t) => [t.slug, t])).values());
---

<section class="mentioned-tools-section" style="margin: 3.5rem 0 2rem;">
  <div class="card" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 2rem 1.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
    <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem;">
      <span class="badge badge-accent" style="font-weight: 700;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
        Direct Directory
      </span>
      <span class="badge badge-neutral" style="font-weight: 600;">{uniqueTools.length} Featured Platforms</span>
    </div>

    <h2 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 0.35rem; letter-spacing: -0.02em;">
      {title}
    </h2>
    <p style="font-size: 0.95rem; color: #475569; line-height: 1.5; margin-bottom: 1.5rem; max-width: 780px;">
      {subtitle}
    </p>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
      {uniqueTools.map((t) => (
        <div class="mentioned-tool-item" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.15rem 1.25rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; transition: border-color 0.2s ease, box-shadow 0.2s ease;">
          <div style="display: flex; align-items: center; gap: 1rem; min-width: 0;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; padding: 6px;">
              <img
                src={t.logo_url}
                alt={`${t.tool_name} logo`}
                width="36"
                height="36"
                loading="lazy"
                decoding="async"
                style="max-width: 100%; max-height: 100%; object-fit: contain;"
                onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'36\' height=\'36\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%232563eb\' stroke-width=\'2\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'4\'/><text x=\'50%\' y=\'55%\' dominant-baseline=\'middle\' text-anchor=\'middle\' font-size=\'10\' font-weight=\'bold\' fill=\'%232563eb\'>${t.tool_name.substring(0, 2).toUpperCase()}</text></svg>';"
              />
            </div>
            <div style="min-width: 0;">
              <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0;">
                  <a href={`/tools/${t.slug}`} style="color: #0f172a; text-decoration: none;">
                    {t.tool_name}
                  </a>
                </h3>
                <span class="badge badge-neutral" style="font-size: 0.75rem;">{t.category}</span>
                <span style="font-size: 0.82rem; font-weight: 700; color: #b45309;">★ {t.rating}</span>
              </div>
              <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.2rem;">
                Starting at <strong style="color: #0f172a;">{t.pricing_starting_at}</strong> • {t.pricing_model}
              </div>
            </div>
          </div>

          <div class="mentioned-actions" style="display: flex; gap: 0.65rem; align-items: center; flex-shrink: 0;">
            <a
              href={`/tools/${t.slug}`}
              class="btn btn-secondary"
              style="padding: 0.6rem 0.9rem; font-size: 0.85rem;"
            >
              Full Review
            </a>
            <a
              href={getOutboundUrl(t)}
              target="_blank"
              rel="sponsored nofollow noopener noreferrer"
              class="btn btn-primary"
              style="padding: 0.6rem 1.1rem; font-size: 0.85rem; white-space: nowrap;"
            >
              Visit Official Site &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 640px) {
    .mentioned-tool-item {
      flex-direction: column !important;
      align-items: stretch !important;
      text-align: left;
    }
    .mentioned-actions {
      display: grid !important;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      margin-top: 0.5rem;
    }
  }
</style>
