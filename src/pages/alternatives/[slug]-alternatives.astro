---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQSection from '../../components/FAQSection.astro';
import MentionedToolsBox from '../../components/MentionedToolsBox.astro';
import { getAllTools, getResolvedAlternatives, getOutboundUrl } from '../../lib/data-loader';
import { generateToolFAQs } from '../../lib/content-engine';
import { generateFAQPageSchema, generateBreadcrumbSchema } from '../../lib/schema-generator';
import { buildSEOMetadata } from '../../lib/seo-engine';
import type { EnrichedSaaSTool } from '../../schemas/tool.schema';

export async function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool }
  }));
}

interface Props {
  tool: EnrichedSaaSTool;
}

const { tool } = Astro.props;
const alternatives = getResolvedAlternatives(tool);
const faqs = generateToolFAQs(tool, alternatives);
const siteUrl = (process.env.PUBLIC_SITE_URL || 'https://stackvs.xyz').replace(/\/+$/, '');
const pageUrl = `${siteUrl}/alternatives/${tool.slug}-alternatives`;

const seo = buildSEOMetadata({
  title: `Top ${alternatives.length} ${tool.tool_name} Alternatives & Competitors (2026)`,
  description: `Looking for an alternative to ${tool.tool_name}? Compare the top ${alternatives.length} competitors in ${tool.category} based on pricing, features, and ratings.`,
  canonicalPath: `/alternatives/${tool.slug}-alternatives`,
  ogSlug: `alt-${tool.slug}`,
  shouldIndex: tool.seo_metrics.should_index && alternatives.length > 0,
  lastModified: tool.last_updated,
  schemas: [
    generateFAQPageSchema(faqs),
    generateBreadcrumbSchema([
      { name: 'Home', url: siteUrl },
      { name: tool.tool_name, url: `${siteUrl}/tools/${tool.slug}` },
      { name: `${tool.tool_name} Alternatives`, url: pageUrl }
    ])
  ]
});
---

<BaseLayout seo={seo}>
  <!-- Hero Card with Logo -->
  <div class="card" style="margin-bottom: 2rem; background: #ffffff; border: 1.5px solid #e2e8f0; padding: 2rem 1.5rem;">
    <div style="display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap;">
      <div style="width: 58px; height: 58px; border-radius: 12px; background: #f8fafc; border: 1.5px solid #e2e8f0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 6px;">
        <img
          src={tool.logo_url}
          alt={`${tool.tool_name} logo`}
          width="44"
          height="44"
          loading="eager"
          style="max-width: 100%; max-height: 100%; object-fit: contain;"
          onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'44\' height=\'44\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%232563eb\' stroke-width=\'2\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'4\'/><text x=\'50%\' y=\'55%\' dominant-baseline=\'middle\' text-anchor=\'middle\' font-size=\'10\' font-weight=\'bold\' fill=\'%232563eb\'>${tool.tool_name.substring(0, 2).toUpperCase()}</text></svg>';"
        />
      </div>

      <div style="min-width: 0; flex: 1;">
        <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.35rem; flex-wrap: wrap;">
          <span class="badge badge-accent">Alternative Guide</span>
          <span class="badge badge-neutral">{tool.category}</span>
          <span class="badge badge-warning">★ {tool.rating}</span>
        </div>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; color: #0f172a; margin: 0.25rem 0 0.5rem; letter-spacing: -0.025em; line-height: 1.2;">
          Best {tool.tool_name} Alternatives & Competitors (2026)
        </h1>
        <p style="font-size: 1.05rem; color: #475569; max-width: 820px; line-height: 1.6;">
          While {tool.tool_name} excels in {tool.pros[0]}, common challenges like {tool.cons[0]} lead organizations to explore alternatives. Below is our side-by-side benchmark of the top {alternatives.length} verified competitors.
        </p>
      </div>
    </div>
  </div>

  <!-- Comparison Table with Screenshots & Logos -->
  <ComparisonTable tools={[tool, ...alternatives]} />

  <!-- Detailed Alternative Cards -->
  <div style="margin: 3.5rem 0 2rem;">
    <h2 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin-bottom: 1.25rem;">
      Individual Competitor Evaluations
    </h2>
    <div class="grid-2">
      {alternatives.map((alt, idx) => {
        const [first, second] = [tool.slug, alt.slug].sort((a, b) => a.localeCompare(b));
        return (
          <div class="card card-hover" style="display: flex; flex-direction: column; justify-content: space-between; border: 1.5px solid #e2e8f0; background: #ffffff;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem;">
                <span class="badge badge-accent" style="font-weight: 700;">Alternative #{idx + 1}</span>
                <span class="badge badge-warning" style="font-weight: 700;">★ {alt.rating}</span>
              </div>

              <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.65rem;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 4px;">
                  <img
                    src={alt.logo_url}
                    alt={`${alt.tool_name} logo`}
                    width="28"
                    height="28"
                    loading="lazy"
                    style="max-width: 100%; max-height: 100%; object-fit: contain;"
                    onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'28\' height=\'28\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%232563eb\' stroke-width=\'2\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'4\'/><text x=\'50%\' y=\'55%\' dominant-baseline=\'middle\' text-anchor=\'middle\' font-size=\'10\' font-weight=\'bold\' fill=\'%232563eb\'>${alt.tool_name.substring(0, 2).toUpperCase()}</text></svg>';"
                  />
                </div>
                <h3 style="font-size: 1.3rem; font-weight: 800; color: #0f172a; margin: 0;">
                  <a href={`/tools/${alt.slug}`} style="color: #0f172a; text-decoration: none;">
                    {alt.tool_name}
                  </a>
                </h3>
              </div>

              <p style="font-size: 0.92rem; color: #475569; margin-bottom: 0.85rem; line-height: 1.55;">
                {alt.summary}
              </p>

              <div style="background: #f8fafc; padding: 0.75rem; border-radius: 8px; border: 1px solid #e2e8f0; font-size: 0.88rem; margin-bottom: 1rem;">
                <div><strong>Starting Price:</strong> <span style="color: #0f172a;">{alt.pricing_starting_at}</span> ({alt.pricing_model})</div>
                <div style="color: #047857; margin-top: 0.25rem;"><strong>Primary Advantage:</strong> {alt.pros[0]}</div>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;">
              <a href={`/compare/${first}-vs-${second}`} class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.6rem 0.5rem;">
                Direct Comparison
              </a>
              <a
                href={getOutboundUrl(alt)}
                target="_blank"
                rel="sponsored nofollow noopener noreferrer"
                class="btn btn-primary"
                style="font-size: 0.85rem; padding: 0.6rem 0.5rem;"
              >
                Visit Site &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- FAQs -->
  <FAQSection faqs={faqs} heading={`Frequently Asked Questions on ${tool.tool_name} Competitors`} />

  <!-- Mentioned Tools Section -->
  <MentionedToolsBox
    tools={[tool, ...alternatives]}
    title={`Official Links for ${tool.tool_name} and All Alternatives`}
    subtitle={`Direct registration and official website links for all ${tool.category} platforms evaluated in this guide:`}
  />
</BaseLayout>
